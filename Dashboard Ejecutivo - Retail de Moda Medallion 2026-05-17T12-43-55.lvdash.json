{
  "datasets": [
    {
      "name": "price_tier_analysis",
      "displayName": "Price Tier Analysis",
      "queryLines": [
        "SELECT\n",
        "  price_tier,\n",
        "  season,\n",
        "  SUM(total_revenue) as revenue,\n",
        "  AVG(gross_margin) as avg_margin,\n",
        "  SUM(units_sold) as units\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  price_tier,\n",
        "  season\n",
        "ORDER BY\n",
        "  price_tier,\n",
        "  season"
      ]
    },
    {
      "name": "season_category_metrics",
      "displayName": "Season Category Metrics",
      "queryLines": [
        "SELECT\n",
        "  season,\n",
        "  category,\n",
        "  SUM(units_sold) as total_units,\n",
        "  SUM(total_revenue) as total_revenue,\n",
        "  SUM(total_gross_profit) as total_profit,\n",
        "  AVG(gross_margin) as avg_margin,\n",
        "  AVG(rating) as avg_rating,\n",
        "  COUNT(DISTINCT product_id) as sku_count\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  season,\n",
        "  category\n",
        "ORDER BY\n",
        "  season,\n",
        "  total_units DESC"
      ]
    },
    {
      "name": "monthly_trends",
      "displayName": "Monthly Trends",
      "queryLines": [
        "SELECT\n",
        "  DATE_FORMAT(sale_date_ts, 'yyyy-MM') as month_label,\n",
        "  season,\n",
        "  SUM(total_revenue) as monthly_revenue,\n",
        "  SUM(units_sold) as monthly_units\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  DATE_FORMAT(sale_date_ts, 'yyyy-MM'),\n",
        "  season\n",
        "ORDER BY\n",
        "  month_label"
      ]
    },
    {
      "name": "color_preferences",
      "displayName": "Color Preferences",
      "queryLines": [
        "SELECT\n",
        "  color,\n",
        "  SUM(units_sold) as total_units,\n",
        "  SUM(total_revenue) as total_revenue\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  color\n",
        "ORDER BY\n",
        "  total_units DESC\n",
        "LIMIT 12"
      ]
    },
    {
      "name": "gender_segment",
      "displayName": "Gender Segment Analysis",
      "queryLines": [
        "SELECT\n",
        "  gender,\n",
        "  price_tier,\n",
        "  SUM(total_revenue) as total_revenue\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  gender,\n",
        "  price_tier\n",
        "ORDER BY\n",
        "  gender,\n",
        "  price_tier"
      ]
    },
    {
      "name": "brand_performance",
      "displayName": "Brand Performance",
      "queryLines": [
        "SELECT\n",
        "  brand,\n",
        "  SUM(total_revenue) as total_revenue,\n",
        "  AVG(gross_margin) as avg_margin,\n",
        "  AVG(rating) as avg_rating\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  brand\n",
        "ORDER BY\n",
        "  total_revenue DESC"
      ]
    },
    {
      "name": "category_profit",
      "displayName": "Category Profit",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  SUM(total_gross_profit) as total_profit\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  category\n",
        "ORDER BY\n",
        "  total_profit DESC"
      ]
    },
    {
      "name": "category_rating",
      "displayName": "Category Rating",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  AVG(rating) as avg_rating\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  category\n",
        "ORDER BY\n",
        "  avg_rating DESC"
      ]
    },
    {
      "name": "quarterly_units",
      "displayName": "Quarterly Units",
      "queryLines": [
        "SELECT\n",
        "  year,\n",
        "  quarter,\n",
        "  CONCAT(CAST(year AS STRING), ' ', quarter) as period,\n",
        "  SUM(units_sold) as total_units\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "GROUP BY\n",
        "  year,\n",
        "  quarter\n",
        "ORDER BY\n",
        "  year,\n",
        "  quarter"
      ]
    },
    {
      "name": "scatter_price_margin",
      "displayName": "Price vs Margin Scatter",
      "queryLines": [
        "SELECT\n",
        "  sale_price,\n",
        "  gross_margin,\n",
        "  price_tier\n",
        "FROM\n",
        "  workspace.default.clothes_silver_layer\n",
        "ORDER BY\n",
        "  RAND()\n",
        "LIMIT 1200"
      ]
    }
  ],
